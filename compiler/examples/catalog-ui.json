        "id": "footer",
        "type": "text",
        "props": {"text": "Compiled from one JSON source to SwiftUI + Android Views"},
        "style": {"color": "#5B6779FF", "fontSize": 11, "fontWeight": "medium", "fillWidth": true, "alignment": "center"}
