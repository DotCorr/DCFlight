          {"id": "resetBtn", "type": "button", "props": {"text": "Reset"}, "action": "reset", "style": {"backgroundColor": "#1D2538FF", "color": "#9BA8B9FF", "fontSize": 14, "fontWeight": "medium", "cornerRadius": 12, "padding": 14, "fillWidth": true}},
