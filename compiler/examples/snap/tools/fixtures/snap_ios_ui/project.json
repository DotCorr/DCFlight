{
  "name": "SnapUIProbe",
  "options": {
    "deploymentTarget": {
      "iOS": "18.0"
    }
  },
  "settings": {
    "base": {
      "SWIFT_VERSION": "6.0",
      "CODE_SIGN_IDENTITY": "-",
      "CODE_SIGNING_ALLOWED": "YES",
      "GENERATE_INFOPLIST_FILE": "YES"
    }
  },
  "targets": {
    "Host": {
      "type": "application",
      "platform": "iOS",
      "sources": [
        "Host"
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.dotcorr.snapuiprobe.host",
          "INFOPLIST_KEY_UILaunchScreen_Generation": "YES"
        }
      }
    },
    "UITests": {
      "type": "bundle.ui-testing",
      "platform": "iOS",
      "sources": [
        "UITests"
      ],
      "dependencies": [
        {
          "target": "Host"
        }
      ],
      "settings": {
        "base": {
          "PRODUCT_BUNDLE_IDENTIFIER": "com.dotcorr.snapuiprobe.tests",
          "TEST_TARGET_NAME": "Host"
        }
      }
    }
  },
  "schemes": {
    "SnapUIProbe": {
      "build": {
        "targets": {
          "Host": "all",
          "UITests": [
            "test"
          ]
        }
      },
      "test": {
        "targets": [
          "UITests"
        ]
      }
    }
  }
}