{
  "version": 1,
  "capabilities": [
    {
      "id": "text",
      "properties": {
        "text": {
          "type": "string"
        }
      },
      "style": [
        "color",
        "fontSize",
        "fontWeight",
        "padding",
        "backgroundColor",
        "cornerRadius",
        "fillWidth"
      ],
      "children": false,
      "action": false,
      "targets": {
        "ios": {
          "expression": "Text({text})",
          "symbol": "Text",
          "source": "https://developer.apple.com/documentation/swiftui"
        },
        "android": {
          "className": "android.widget.TextView",
          "update": "{view}.setText({text});",
          "source": "https://developer.android.com/reference/android/widget/TextView"
        }
      }
    },
    {
      "id": "counter",
      "properties": {
        "value": {
          "type": "int"
        }
      },
