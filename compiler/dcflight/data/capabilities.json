    {
      "id": "column",
      "properties": {},
      "style": [
        "spacing",
        "alignment",
        "padding",
        "backgroundColor",
        "cornerRadius",
        "fillWidth"
      ],
      "children": true,
      "action": false,
      "targets": {
        "ios": {
          "expression": "VStack(alignment: .leading) {\n{children}\n}",
          "symbol": "VStack",
          "source": "https://developer.apple.com/documentation/swiftui"
        },
        "android": {
          "className": "android.widget.LinearLayout",
          "update": "{view}.setOrientation(android.widget.LinearLayout.VERTICAL);",
          "source": "https://developer.android.com/reference/android/widget/LinearLayout"
        }
      }
    },
    {
      "id": "row",
